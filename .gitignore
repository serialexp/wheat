/target
# Vendored crates are built standalone now and then (to check a patch); keep their
# target directories out.
vendor/*/target/
# Benchmarks run from inside a crate write a relative `target/`.
crates/*/target/
# Disposable Git projections generated by the local Wheat client.
.wheat-git/
# `wheat-bench` copies each run's results here too; the dated files are committed.
bench/results/*/latest.tsv
# `wheat-bench`'s default report output.
/profile.json
