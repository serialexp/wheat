#!/usr/bin/env bash
# Regenerate Wheat's committed BinSchema Rust wire types.
#
# Usage:
#   scripts/wheat-gen-schema
#   scripts/wheat-gen-schema --check

set -euo pipefail

CHECK=0
if [[ "${1:-}" == "--check" ]]; then
    CHECK=1
fi

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CRATE_DIR="${REPO_ROOT}/crates/wheat-core"
SCHEMA="${CRATE_DIR}/schemas/wheat-objects.bs.json5"
OUT_DIR="${CRATE_DIR}/generated"
BINSCHEMA_REPO="${BINSCHEMA_REPO:-${HOME}/Projects/binschema}"
BINSCHEMA_REVISION="f48a34a77aae6fd0f476ed246f03083db8953045"
BINSCHEMA_CLI="${BINSCHEMA_REPO}/packages/binschema/dist/cli/index.js"

if [[ ! -f "${BINSCHEMA_CLI}" ]]; then
    echo "binschema CLI not found at ${BINSCHEMA_CLI}" >&2
    echo "expected: ~/Projects/binschema built (cd ~/Projects/binschema && pnpm install && pnpm -r build)" >&2
    exit 1
fi

ACTUAL_REVISION="$(git -C "${BINSCHEMA_REPO}" rev-parse HEAD 2>/dev/null || true)"
if [[ "${ACTUAL_REVISION}" != "${BINSCHEMA_REVISION}" ]]; then
    echo "Wheat codegen requires binschema revision ${BINSCHEMA_REVISION}" >&2
    echo "found ${ACTUAL_REVISION:-no Git checkout} at ${BINSCHEMA_REPO}" >&2
    exit 1
fi

regenerate() {
    local output="$1"
    node "${BINSCHEMA_CLI}" generate --language rust --schema "${SCHEMA}" --out "${output}"
    # Each generated bundle vendors its runtime. Give Wheat's copies unique
    # Cargo package names while retaining the `binschema_runtime` Rust crate alias.
    sed -i 's/name = "binschema-generated"/name = "wheat-binschema-generated"/' \
        "${output}/Cargo.toml"
    sed -i 's|binschema-runtime = { path = "binschema_runtime" }|binschema-runtime = { package = "wheat-binschema-runtime", path = "binschema_runtime" }|' \
        "${output}/Cargo.toml"
    sed -i 's/name = "binschema-runtime"/name = "wheat-binschema-runtime"/' \
        "${output}/binschema_runtime/Cargo.toml"
}

if [[ "${CHECK}" -eq 1 ]]; then
    TMP_DIR="$(mktemp -d)"
    trap 'rm -rf "${TMP_DIR}"' EXIT
    regenerate "${TMP_DIR}/generated"
    if ! diff -ruN "${OUT_DIR}" "${TMP_DIR}/generated" >/dev/null; then
        echo "Wheat codegen is out of date — run scripts/wheat-gen-schema and commit the result" >&2
        diff -ruN "${OUT_DIR}" "${TMP_DIR}/generated" | head -200 >&2
        exit 1
    fi
    echo "Wheat codegen is up to date"
    exit 0
fi

rm -rf "${OUT_DIR}"
regenerate "${OUT_DIR}"
echo "regenerated ${OUT_DIR}"
