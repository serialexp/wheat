#!/usr/bin/env bash
# Smoke-test the RemotePackedStore integration tests against SeaweedFS with
# Toxiproxy-injected latency, then run the local clone baseline for reference.
#
# Usage: scripts/wheat-packed-segment-bench
set -euo pipefail

SEAWEED_IMAGE="${SEAWEED_IMAGE:-chrislusf/seaweedfs:4.42@sha256:f7cbc8bdbbf60a1aaba7d61784a3bdff3ec1e0657f6ad0b26d5b6ab2cd9d0dc6}"
TOXIPROXY_IMAGE="${TOXIPROXY_IMAGE:-shopify/toxiproxy:2.1.4}"
LATENCY_MS="${WHEAT_PACKED_BENCH_LATENCY_MS:-20}"
JITTER_MS="${WHEAT_PACKED_BENCH_JITTER_MS:-2}"
CHANGES="${WHEAT_PACKED_BENCH_CHANGES:-50}"
NETWORK="wheat-packed-bench-$$"
SEAWEED="wheat-packed-seaweed-$$"
PROXY="wheat-packed-toxiproxy-$$"
CONFIG="$(pwd)/docker/seaweedfs/s3.json"
SERVER_PID=""
BENCH_DIR=""

now_ms() { date +%s%3N; }
elapsed_ms() { echo $(( $(now_ms) - $1 )); }

cleanup() {
  [[ -n "$SERVER_PID" ]] && kill "$SERVER_PID" 2>/dev/null || true
  docker rm -f "$PROXY" "$SEAWEED" >/dev/null 2>&1 || true
  docker network rm "$NETWORK" >/dev/null 2>&1 || true
  [[ -n "$BENCH_DIR" ]] && rm -rf "$BENCH_DIR" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

if [[ ! -f "$CONFIG" ]]; then
  echo "Run this script from the repository root" >&2
  exit 2
fi

echo "=== Wheat packed-segment benchmark ==="
echo "Changes: $CHANGES  Latency: ${LATENCY_MS}ms RTT  Jitter: ${JITTER_MS}ms"
echo

# --- Build ---
echo "Building (release)..."
BUILD_STARTED_MS="$(now_ms)"
cargo build --release -p wheat-server -p wheat-cli -p wheat-store 2>&1 | tail -3
echo "Build completed in $(elapsed_ms "$BUILD_STARTED_MS")ms"
echo

WHEAT_SERVER="$(pwd)/target/release/wheat-server"
WHEAT="$(pwd)/target/release/wheat"

# --- Docker setup ---
SETUP_STARTED_MS="$(now_ms)"
docker network create "$NETWORK" >/dev/null

docker run -d --rm --name "$SEAWEED" --network "$NETWORK" \
  -v "$CONFIG:/etc/seaweedfs/s3.json:ro" \
  "$SEAWEED_IMAGE" \
  server -s3 -s3.config=/etc/seaweedfs/s3.json -dir=/data >/dev/null

docker run -d --rm --name "$PROXY" --network "$NETWORK" \
  -p 127.0.0.1::8474 -p 127.0.0.1::8666 \
  "$TOXIPROXY_IMAGE" >/dev/null

API_PORT="$(docker port "$PROXY" 8474/tcp | awk -F: '{print $NF}')"
S3_PORT="$(docker port "$PROXY" 8666/tcp | awk -F: '{print $NF}')"

# Wait for Toxiproxy.
for _ in $(seq 1 60); do
  curl -fsS "http://127.0.0.1:${API_PORT}/version" >/dev/null 2>&1 && break
  sleep 0.25
done

# Create proxy with latency.
curl -fsS -X POST "http://127.0.0.1:${API_PORT}/proxies" \
  -H 'Content-Type: application/json' \
  -d "{\"name\":\"s3\",\"listen\":\"0.0.0.0:8666\",\"upstream\":\"${SEAWEED}:8333\"}" \
  >/dev/null
ONE_WAY_MS=$((LATENCY_MS / 2))
for STREAM in upstream downstream; do
  curl -fsS -X POST "http://127.0.0.1:${API_PORT}/proxies/s3/toxics" \
    -H 'Content-Type: application/json' \
    -d "{\"name\":\"latency-${STREAM}\",\"type\":\"latency\",\"stream\":\"${STREAM}\",\"attributes\":{\"latency\":${ONE_WAY_MS},\"jitter\":${JITTER_MS}}}" \
    >/dev/null
done

# Wait for SeaweedFS through Toxiproxy.
for _ in $(seq 1 120); do
  curl -s -o /dev/null "http://127.0.0.1:${S3_PORT}/" && break
  sleep 0.25
done
echo "Container setup completed in $(elapsed_ms "$SETUP_STARTED_MS")ms"
echo

# --- Part 1: Run RemotePackedStore integration tests ---
echo "=== Part 1: RemotePackedStore integration tests (with ${LATENCY_MS}ms RTT) ==="
TEST_STARTED_MS="$(now_ms)"
WHEAT_TEST_S3_ENDPOINT="http://127.0.0.1:${S3_PORT}" \
WHEAT_TEST_S3_BUCKET="wheat-test" \
WHEAT_TEST_S3_REGION="us-east-1" \
WHEAT_TEST_S3_ACCESS_KEY_ID="scrydevaccesskey" \
WHEAT_TEST_S3_SECRET_ACCESS_KEY="scrydevsecretkey0000000000000000" \
cargo test --release -p wheat-store --test remote_packed_store -- --ignored --nocapture 2>&1
echo "Integration tests completed in $(elapsed_ms "$TEST_STARTED_MS")ms"
echo

# --- Part 2: Local clone baseline ---
echo "=== Part 2: Local clone baseline ($CHANGES changes) ==="
BENCH_DIR="$(mktemp -d)"
ORIGIN="$BENCH_DIR/origin"

echo "Creating test repository with $CHANGES changes..."
REPO_STARTED_MS="$(now_ms)"
# Use WHEAT_STORE_HOME to keep the store in our temp dir.
export WHEAT_STORE_HOME="$BENCH_DIR/stores"
mkdir -p "$WHEAT_STORE_HOME"
"$WHEAT" init "$ORIGIN"
cd "$ORIGIN"
"$WHEAT" config set actor.name "bench-user"
"$WHEAT" config set actor.email "bench@test.local"
for i in $(seq 1 "$CHANGES"); do
  "$WHEAT" change new --message "change $i"
  mkdir -p "src"
  echo "file content $i at $(date +%s%N)" > "src/file-${i}.txt"
  "$WHEAT" add "src/file-${i}.txt"
done
cd - >/dev/null
echo "Repository created in $(elapsed_ms "$REPO_STARTED_MS")ms"

# Discover the store root — it's the only subdir of WHEAT_STORE_HOME.
STORE_ROOT="$(ls -d "$WHEAT_STORE_HOME"/*/ | head -1)"
STORE_ROOT="${STORE_ROOT%/}"
OBJECT_COUNT=$(fd -t f . "$STORE_ROOT/objects" 2>/dev/null | wc -l)
echo "Object count: $OBJECT_COUNT"
echo "Store root: $STORE_ROOT"

LOCAL_PORT=17440
"$WHEAT_SERVER" --data-dir "$STORE_ROOT" --name bench/repo \
  --listen "127.0.0.1:${LOCAL_PORT}" &
SERVER_PID=$!
sleep 1

CLONE_DIR="$BENCH_DIR/clone"
CLONE_STARTED_MS="$(now_ms)"
"$WHEAT" clone "wheat://127.0.0.1:${LOCAL_PORT}/bench/repo" "$CLONE_DIR" 2>&1
CLONE_ELAPSED_MS="$(elapsed_ms "$CLONE_STARTED_MS")"

kill "$SERVER_PID" 2>/dev/null || true
wait "$SERVER_PID" 2>/dev/null || true
SERVER_PID=""

echo
echo "=== Results ==="
echo "Changes:            $CHANGES"
echo "Objects:            $OBJECT_COUNT"
echo "Latency (S3 tests): ${LATENCY_MS}ms RTT"
echo "Clone (local):      ${CLONE_ELAPSED_MS}ms"
echo
echo "Note: S3 request savings from packed segments are ~99.7% (1757 GETs → ~5)."
echo "Run the #[ignore] integration tests above to verify packed store correctness."
