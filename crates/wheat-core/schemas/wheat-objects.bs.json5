{
  // Canonical immutable-object encoding for the Wheat prototype.
  //
  // Object identity is BLAKE3-256 over the complete encoded WheatObject bytes.
  // The first uint16 is (object kind << 8) | encoding version. Assigning a new
  // wire tag for an incompatible encoding keeps old bytes and identities valid.
  // Arrays that model maps or sets MUST be sorted and unique before encoding;
  // BinSchema defines framing, while wheat-core validates those invariants.
  meta: {
    title: "Wheat Immutable Repository Objects",
    description: "Canonical encodings for trees, changes, revisions, applications, conflicts, views, and content manifests.",
    version: "0.1.0",
  },
  config: {
    endianness: "big_endian",
    bit_order: "msb_first",
  },
  types: {
    WheatObject: {
      type: "discriminated_union",
      discriminator: { peek: "uint16", endianness: "big_endian" },
      variants: [
        { type: "TreeV1", when: "value == 0x0101" },
        { type: "ChangeV1", when: "value == 0x0201" },
        { type: "RevisionV1", when: "value == 0x0301" },
        { type: "ApplicationV1", when: "value == 0x0401" },
        { type: "ConflictV1", when: "value == 0x0501" },
        { type: "ViewV1", when: "value == 0x0601" },
        { type: "ContentMapNodeV1", when: "value == 0x0701" },
        { type: "RepositoryStateV1", when: "value == 0x0801" },
        { type: "RevisionMapNodeV1", when: "value == 0x0901" },
        { type: "ApplicationMapNodeV1", when: "value == 0x0a01" },
        { type: "ConflictSetNodeV1", when: "value == 0x0b01" },
        { type: "ContentSetNodeV1", when: "value == 0x0c01" },
        { type: "RetainedSetNodeV1", when: "value == 0x0d01" },
        { type: "ViewLabelManifestV1", when: "value == 0x0e01" },
        { type: "RepositoryEnvelopeV1", when: "value == 0x0f01" },
        { type: "EditV1", when: "value == 0x1001" },
        { type: "ChangeMapNodeV1", when: "value == 0x1101" },
        { type: "ViewLineageMapNodeV1", when: "value == 0x1201" },
      ],
    },

    Uuid128: {
      sequence: [
        { name: "bytes", type: "bytes", kind: "fixed", length: 16 },
      ],
    },
    Digest256: {
      sequence: [
        { name: "bytes", type: "bytes", kind: "fixed", length: 32 },
      ],
    },
    ContentId: {
      sequence: [
        // 1 = BLAKE3-256. The algorithm tag is part of every reference.
        { name: "algorithm", type: "uint8" },
        { name: "digest", type: "Digest256" },
      ],
    },
    // Change identity is stable collaboration identity, not object identity.
    ChangeId: { sequence: [{ name: "uuid", type: "Uuid128" }] },
    // Every other metadata ID is the BLAKE3-256 address of the referenced
    // object's complete canonical WheatObject encoding.
    RevisionId: { sequence: [{ name: "digest", type: "Digest256" }] },
    EditId: { sequence: [{ name: "digest", type: "Digest256" }] },
    TreeId: { sequence: [{ name: "digest", type: "Digest256" }] },
    ChangeObjectId: { sequence: [{ name: "digest", type: "Digest256" }] },
    ApplicationId: { sequence: [{ name: "digest", type: "Digest256" }] },
    ConflictId: { sequence: [{ name: "digest", type: "Digest256" }] },
    ViewId: { sequence: [{ name: "digest", type: "Digest256" }] },
    ContentMapId: { sequence: [{ name: "digest", type: "Digest256" }] },
    RevisionMapId: { sequence: [{ name: "digest", type: "Digest256" }] },
    ChangeMapId: { sequence: [{ name: "digest", type: "Digest256" }] },
    ApplicationMapId: { sequence: [{ name: "digest", type: "Digest256" }] },
    ConflictSetId: { sequence: [{ name: "digest", type: "Digest256" }] },
    ContentSetId: { sequence: [{ name: "digest", type: "Digest256" }] },
    RetainedSetId: { sequence: [{ name: "digest", type: "Digest256" }] },
    ViewLineageMapId: { sequence: [{ name: "digest", type: "Digest256" }] },
    RepositoryStateId: { sequence: [{ name: "digest", type: "Digest256" }] },
    ViewLabelManifestId: { sequence: [{ name: "digest", type: "Digest256" }] },

    TreeV1: {
      sequence: [
        { name: "wire_tag", type: "uint16", const: 0x0101 },
        {
          name: "entries",
          type: "array",
          kind: "length_prefixed",
          length_type: "uint32",
          items: { type: "DirectoryEntryV1" },
        },
      ],
    },
    DirectoryEntryV1: {
      sequence: [
        {
          name: "name",
          type: "string",
          kind: "length_prefixed",
          length_type: "uint32",
          encoding: "utf8",
        },
        { name: "value", type: "DirectoryEntryValueV1" },
      ],
    },
    DirectoryEntryValueV1: {
      type: "discriminated_union",
      discriminator: { peek: "uint8" },
      variants: [
        { type: "FileEntryV1", when: "value == 0" },
        { type: "DirectoryEntryRefV1", when: "value == 1" },
      ],
    },
    FileKindV1: {
      sequence: [
        // 0 = regular, 1 = executable, 2 = symbolic link.
        { name: "value", type: "uint8" },
      ],
    },
    FileValueV1: {
      sequence: [
        { name: "content", type: "ContentId" },
        { name: "kind", type: "FileKindV1" },
      ],
    },
    FileEntryV1: {
      sequence: [
        { name: "entry_kind", type: "uint8", const: 0 },
        { name: "value", type: "FileValueV1" },
      ],
    },
    DirectoryEntryRefV1: {
      sequence: [
        { name: "entry_kind", type: "uint8", const: 1 },
        { name: "directory", type: "TreeId" },
      ],
    },

    ActorV1: {
      sequence: [
        { name: "name", type: "string", kind: "length_prefixed", length_type: "uint32", encoding: "utf8" },
        { name: "email", type: "string", kind: "length_prefixed", length_type: "uint32", encoding: "utf8" },
      ],
    },
    TimestampV1: {
      sequence: [
        { name: "seconds", type: "int64" },
        { name: "offset_minutes", type: "int16" },
      ],
    },
    SourceProvenanceV1: {
      sequence: [
        { name: "system", type: "string", kind: "length_prefixed", length_type: "uint32", encoding: "utf8" },
        { name: "object_id", type: "bytes", kind: "length_prefixed", length_type: "uint32" },
        { name: "parent_object_ids", type: "array", kind: "length_prefixed", length_type: "uint32", items: { type: "SourceObjectIdV1" } },
      ],
    },
    SourceObjectIdV1: {
      sequence: [
        { name: "bytes", type: "bytes", kind: "length_prefixed", length_type: "uint32" },
      ],
    },
    ChangeMetadataV1: {
      sequence: [
        { name: "title", type: "string", kind: "length_prefixed", length_type: "uint32", encoding: "utf8" },
        { name: "description", type: "string", kind: "length_prefixed", length_type: "uint32", encoding: "utf8" },
        { name: "creator", type: "ActorV1" },
        { name: "created_at", type: "TimestampV1" },
        { name: "provenance", type: "optional", value_type: "SourceProvenanceV1" },
      ],
    },
    RevisionMetadataV1: {
      sequence: [
        { name: "message", type: "string", kind: "length_prefixed", length_type: "uint32", encoding: "utf8" },
        { name: "author", type: "ActorV1" },
        { name: "authored_at", type: "TimestampV1" },
        { name: "committer", type: "ActorV1" },
        { name: "committed_at", type: "TimestampV1" },
        { name: "provenance", type: "optional", value_type: "SourceProvenanceV1" },
      ],
    },

    ChangeV1: {
      sequence: [
        { name: "wire_tag", type: "uint16", const: 0x0201 },
        { name: "change_id", type: "ChangeId" },
        { name: "metadata", type: "ChangeMetadataV1" },
      ],
    },

    RevisionV1: {
      sequence: [
        { name: "wire_tag", type: "uint16", const: 0x0301 },
        // RevisionId is the hash of this object, so it is not encoded inside
        // the revision itself.
        { name: "change_id", type: "ChangeId" },
        { name: "metadata", type: "RevisionMetadataV1" },
        {
          // Zero or one element. Wheat validates this cardinality because the
          // current BinSchema Rust generator cannot encode an optional field
          // directly inside a discriminated-union variant.
          name: "predecessors",
          type: "array",
          kind: "length_prefixed",
          length_type: "uint32",
          items: { type: "RevisionId" },
        },
        {
          // A combined revision's other inputs, sorted, never the predecessor;
          // empty for an ordinary revision.
          name: "combines",
          type: "array",
          kind: "length_prefixed",
          length_type: "uint32",
          items: { type: "RevisionId" },
        },
        // 1 + the largest generation among the predecessor and `combines`; 0 with none.
        { name: "generation", type: "uint64" },
        {
          name: "dependencies",
          type: "array",
          kind: "length_prefixed",
          length_type: "uint32",
          items: { type: "ChangeId" },
        },
        { name: "authored_against", type: "ViewId" },
        { name: "edits", type: "array", kind: "length_prefixed", length_type: "uint32", items: { type: "EditId" } },
        { name: "transition", type: "EditTransitionV1" },
        { name: "resulting_tree", type: "TreeId" },
      ],
    },
    EditTransitionV1: {
      sequence: [
        { name: "preserved", type: "array", kind: "length_prefixed", length_type: "uint32", items: { type: "EditId" } },
        { name: "added", type: "array", kind: "length_prefixed", length_type: "uint32", items: { type: "EditId" } },
        { name: "removed", type: "array", kind: "length_prefixed", length_type: "uint32", items: { type: "EditId" } },
        { name: "subsumed", type: "array", kind: "length_prefixed", length_type: "uint32", items: { type: "EditSubsumptionV1" } },
        { name: "resolutions", type: "array", kind: "length_prefixed", length_type: "uint32", items: { type: "ConflictResolutionEvidenceV1" } },
      ],
    },
    EditSubsumptionV1: { sequence: [
      { name: "source", type: "EditId" },
      { name: "replacements", type: "array", kind: "length_prefixed", length_type: "uint32", items: { type: "EditId" } },
    ] },
    ConflictResolutionEvidenceV1: { sequence: [
      { name: "application", type: "ApplicationId" },
      { name: "conflicted_edits", type: "array", kind: "length_prefixed", length_type: "uint32", items: { type: "EditId" } },
      { name: "replacement_edits", type: "array", kind: "length_prefixed", length_type: "uint32", items: { type: "EditId" } },
    ] },

    ApplicationV1: {
      sequence: [
        { name: "wire_tag", type: "uint16", const: 0x0401 },
        { name: "revision_id", type: "RevisionId" },
        { name: "target_view", type: "ViewId" },
        // The change's index in the result view's canonical order: the target's size.
        { name: "position", type: "uint64" },
        {
          // Zero or one element: the target's producing application, none on the
          // base. An array for the same reason as RevisionV1's predecessors.
          name: "previous",
          type: "array",
          kind: "length_prefixed",
          length_type: "uint32",
          items: { type: "ApplicationId" },
        },
        {
          // skip[j]: the application at position - 2^j, for each 2^j <= position.
          name: "skip",
          type: "array",
          kind: "length_prefixed",
          length_type: "uint32",
          items: { type: "ApplicationId" },
        },
        {
          // window_max[j]: the highest ChangeId among the 2^j positions ending at
          // this one, for each 2^j <= position + 1.
          name: "window_max",
          type: "array",
          kind: "length_prefixed",
          length_type: "uint32",
          items: { type: "ChangeId" },
        },
        { name: "result", type: "ApplicationResultV1" },
        { name: "applied", type: "array", kind: "length_prefixed", length_type: "uint32", items: { type: "AppliedEditEntryV1" } },
      ],
    },
    ApplicationResultV1: {
      type: "discriminated_union",
      discriminator: { peek: "uint8" },
      variants: [
        { type: "CleanApplicationV1", when: "value == 0" },
        { type: "ConflictedApplicationV1", when: "value == 1" },
      ],
    },
    CleanApplicationV1: {
      sequence: [
        { name: "result_kind", type: "uint8", const: 0 },
        { name: "resulting_tree", type: "TreeId" },
      ],
    },
    ConflictedApplicationV1: {
      sequence: [
        { name: "result_kind", type: "uint8", const: 1 },
        { name: "partial_tree", type: "TreeId" },
        { name: "conflict", type: "ConflictId" },
      ],
    },

    ConflictV1: {
      sequence: [
        { name: "wire_tag", type: "uint16", const: 0x0501 },
        { name: "target_view", type: "ViewId" },
        {
          name: "edits",
          type: "array",
          kind: "length_prefixed",
          length_type: "uint32",
          items: { type: "FailedEditEntryV1" },
        },
      ],
    },
    ByteRangeV1: { sequence: [{ name: "start", type: "uint64" }, { name: "end", type: "uint64" }] },
    AppliedEditEntryV1: { sequence: [{ name: "edit", type: "EditId" }, { name: "evidence", type: "AppliedEditEvidenceV1" }] },
    AppliedEditEvidenceV1: { sequence: [
      { name: "target", type: "array", kind: "length_prefixed", length_type: "uint32", items: { type: "FileValueV1" } },
      { name: "read", type: "array", kind: "length_prefixed", length_type: "uint32", items: { type: "ByteRangeV1" } },
      { name: "write", type: "array", kind: "length_prefixed", length_type: "uint32", items: { type: "ByteRangeV1" } },
    ] },
    FailedEditEntryV1: { sequence: [{ name: "edit", type: "EditId" }, { name: "evidence", type: "FailedEditEvidenceV1" }] },
    FailedEditEvidenceV1: { sequence: [
      { name: "target", type: "array", kind: "length_prefixed", length_type: "uint32", items: { type: "FileValueV1" } },
      { name: "reason", type: "EditFailureV1" },
    ] },
    EditFailureV1: { type: "discriminated_union", discriminator: { peek: "uint8" }, variants: [
      { type: "NoMatchFailureV1", when: "value == 0" }, { type: "AmbiguousFailureV1", when: "value == 1" },
      { type: "InterferenceFailureV1", when: "value == 2" }, { type: "KindMismatchFailureV1", when: "value == 3" },
      { type: "ExpectedFileMismatchFailureV1", when: "value == 4" },
    ] },
    NoMatchFailureV1: { sequence: [{ name: "failure_kind", type: "uint8", const: 0 }] },
    AmbiguousFailureV1: { sequence: [{ name: "failure_kind", type: "uint8", const: 1 }] },
    InterferenceFailureV1: { sequence: [{ name: "failure_kind", type: "uint8", const: 2 }, { name: "with", type: "array", kind: "length_prefixed", length_type: "uint32", items: { type: "EditId" } }] },
    KindMismatchFailureV1: { sequence: [{ name: "failure_kind", type: "uint8", const: 3 }] },
    ExpectedFileMismatchFailureV1: { sequence: [{ name: "failure_kind", type: "uint8", const: 4 }] },

    ViewV1: {
      sequence: [
        { name: "wire_tag", type: "uint16", const: 0x0601 },
        { name: "tree", type: "TreeId" },
        { name: "revisions", type: "RevisionMapId" },
        { name: "applications", type: "ApplicationMapId" },
        { name: "unresolved_conflicts", type: "ConflictSetId" },
        // The blobs the tree names, each with the number of tree entries naming it.
        { name: "required_content", type: "ContentMapId" },
        // The number of changes in `revisions`.
        { name: "size", type: "uint64" },
        {
          // Zero or one element: the last change in the canonical order, none for
          // the base. An array for the same reason as RevisionV1's predecessors.
          name: "last",
          type: "array",
          kind: "length_prefixed",
          length_type: "uint32",
          items: { type: "ChangeId" },
        },
        // The sum over its changes of 1 + their revision's generation. Every lineage
        // edge increases it.
        { name: "weight", type: "uint64" },
      ],
    },

    // Radix map from a ContentId's 32 digest bytes to a count of at least 1.
    ContentMapNodeV1: {
      sequence: [
        { name: "wire_tag", type: "uint16", const: 0x0701 },
        { name: "prefix", type: "array", kind: "length_prefixed", length_type: "uint32", items: { type: "uint8" } },
        { name: "value", type: "array", kind: "length_prefixed", length_type: "uint32", items: { type: "uint32" } },
        { name: "children", type: "array", kind: "length_prefixed", length_type: "uint32", items: { type: "ContentMapChildV1" } },
        { name: "entries", type: "array", kind: "length_prefixed", length_type: "uint32", items: { type: "ContentMapEntryV1" } },
      ],
    },
    ContentMapChildV1: {
      sequence: [
        { name: "edge", type: "uint8" },
        { name: "child", type: "ContentMapId" },
      ],
    },
    ContentMapEntryV1: {
      sequence: [
        { name: "suffix", type: "bytes", kind: "length_prefixed", length_type: "uint32" },
        { name: "value", type: "uint32" },
      ],
    },

    RevisionMapNodeV1: {
      sequence: [
        { name: "wire_tag", type: "uint16", const: 0x0901 },
        { name: "prefix", type: "array", kind: "length_prefixed", length_type: "uint32", items: { type: "uint8" } },
        {
          // Zero or one element. A value is legal only after consuming all 16 key bytes.
          name: "value",
          type: "array",
          kind: "length_prefixed",
          length_type: "uint32",
          items: { type: "RevisionId" },
        },
        {
          name: "children",
          type: "array",
          kind: "length_prefixed",
          length_type: "uint32",
          items: { type: "RevisionMapChildV1" },
        },
        {
          // Inline entries: key suffixes with values inlined into this node
          // instead of stored as separate leaf child objects.
          name: "entries",
          type: "array",
          kind: "length_prefixed",
          length_type: "uint32",
          items: { type: "RevisionMapEntryV1" },
        },
      ],
    },
    RevisionMapChildV1: {
      sequence: [
        { name: "edge", type: "uint8" },
        { name: "child", type: "RevisionMapId" },
      ],
    },
    RevisionMapEntryV1: {
      sequence: [
        { name: "suffix", type: "bytes", kind: "length_prefixed", length_type: "uint32" },
        { name: "value", type: "RevisionId" },
      ],
    },

    ChangeMapNodeV1: {
      sequence: [
        { name: "wire_tag", type: "uint16", const: 0x1101 },
        { name: "prefix", type: "array", kind: "length_prefixed", length_type: "uint32", items: { type: "uint8" } },
        { name: "value", type: "array", kind: "length_prefixed", length_type: "uint32", items: { type: "ChangeObjectId" } },
        { name: "children", type: "array", kind: "length_prefixed", length_type: "uint32", items: { type: "ChangeMapChildV1" } },
        { name: "entries", type: "array", kind: "length_prefixed", length_type: "uint32", items: { type: "ChangeMapEntryV1" } },
      ],
    },
    ChangeMapChildV1: {
      sequence: [
        { name: "edge", type: "uint8" },
        { name: "child", type: "ChangeMapId" },
      ],
    },
    ChangeMapEntryV1: {
      sequence: [
        { name: "suffix", type: "bytes", kind: "length_prefixed", length_type: "uint32" },
        { name: "value", type: "ChangeObjectId" },
      ],
    },

    ApplicationMapNodeV1: {
      sequence: [
        { name: "wire_tag", type: "uint16", const: 0x0a01 },
        { name: "prefix", type: "array", kind: "length_prefixed", length_type: "uint32", items: { type: "uint8" } },
        { name: "value", type: "array", kind: "length_prefixed", length_type: "uint32", items: { type: "ApplicationId" } },
        { name: "children", type: "array", kind: "length_prefixed", length_type: "uint32", items: { type: "ApplicationMapChildV1" } },
        { name: "entries", type: "array", kind: "length_prefixed", length_type: "uint32", items: { type: "ApplicationMapEntryV1" } },
      ],
    },
    ApplicationMapChildV1: {
      sequence: [
        { name: "edge", type: "uint8" },
        { name: "child", type: "ApplicationMapId" },
      ],
    },
    ApplicationMapEntryV1: {
      sequence: [
        { name: "suffix", type: "bytes", kind: "length_prefixed", length_type: "uint32" },
        { name: "value", type: "ApplicationId" },
      ],
    },

    ViewLineageMapNodeV1: {
      sequence: [
        { name: "wire_tag", type: "uint16", const: 0x1201 },
        { name: "prefix", type: "array", kind: "length_prefixed", length_type: "uint32", items: { type: "uint8" } },
        { name: "value", type: "array", kind: "length_prefixed", length_type: "uint32", items: { type: "RetainedSetId" } },
        { name: "children", type: "array", kind: "length_prefixed", length_type: "uint32", items: { type: "ViewLineageMapChildV1" } },
        { name: "entries", type: "array", kind: "length_prefixed", length_type: "uint32", items: { type: "ViewLineageMapEntryV1" } },
      ],
    },
    ViewLineageMapChildV1: {
      sequence: [
        { name: "edge", type: "uint8" },
        { name: "child", type: "ViewLineageMapId" },
      ],
    },
    ViewLineageMapEntryV1: {
      sequence: [
        { name: "suffix", type: "bytes", kind: "length_prefixed", length_type: "uint32" },
        { name: "value", type: "RetainedSetId" },
      ],
    },

    ConflictSetNodeV1: {
      sequence: [
        { name: "wire_tag", type: "uint16", const: 0x0b01 },
        { name: "prefix", type: "array", kind: "length_prefixed", length_type: "uint32", items: { type: "uint8" } },
        { name: "present", type: "bool" },
        { name: "children", type: "array", kind: "length_prefixed", length_type: "uint32", items: { type: "ConflictSetChildV1" } },
        // Inline entries: key suffixes for members inlined into this node.
        { name: "entries", type: "array", kind: "length_prefixed", length_type: "uint32", items: { type: "SetEntryV1" } },
      ],
    },
    ConflictSetChildV1: {
      sequence: [
        { name: "edge", type: "uint8" },
        { name: "child", type: "ConflictSetId" },
      ],
    },

    // Radix set of ContentId digests: every blob a repository state needs.
    ContentSetNodeV1: {
      sequence: [
        { name: "wire_tag", type: "uint16", const: 0x0c01 },
        { name: "prefix", type: "array", kind: "length_prefixed", length_type: "uint32", items: { type: "uint8" } },
        { name: "present", type: "bool" },
        { name: "children", type: "array", kind: "length_prefixed", length_type: "uint32", items: { type: "ContentSetChildV1" } },
        { name: "entries", type: "array", kind: "length_prefixed", length_type: "uint32", items: { type: "SetEntryV1" } },
      ],
    },
    ContentSetChildV1: {
      sequence: [
        { name: "edge", type: "uint8" },
        { name: "child", type: "ContentSetId" },
      ],
    },

    RetainedSetNodeV1: {
      sequence: [
        { name: "wire_tag", type: "uint16", const: 0x0d01 },
        { name: "prefix", type: "array", kind: "length_prefixed", length_type: "uint32", items: { type: "uint8" } },
        { name: "present", type: "bool" },
        { name: "children", type: "array", kind: "length_prefixed", length_type: "uint32", items: { type: "RetainedSetChildV1" } },
        { name: "entries", type: "array", kind: "length_prefixed", length_type: "uint32", items: { type: "SetEntryV1" } },
      ],
    },
    RetainedSetChildV1: {
      sequence: [
        { name: "edge", type: "uint8" },
        { name: "child", type: "RetainedSetId" },
      ],
    },

    // Shared inline entry type for set nodes (no value, just suffix).
    SetEntryV1: {
      sequence: [
        { name: "suffix", type: "bytes", kind: "length_prefixed", length_type: "uint32" },
      ],
    },

    RepositoryStateV1: {
      sequence: [
        { name: "wire_tag", type: "uint16", const: 0x0801 },
        { name: "base_view", type: "ViewId" },
        { name: "changes", type: "ChangeMapId" },
        { name: "view_lineage", type: "ViewLineageMapId" },
        // Every blob a retained tree, edit or conflict names.
        { name: "required_content", type: "ContentSetId" },
        { name: "retained_changes", type: "RetainedSetId" },
        { name: "retained_views", type: "RetainedSetId" },
        { name: "retained_revisions", type: "RetainedSetId" },
        { name: "retained_applications", type: "RetainedSetId" },
      ],
    },

    ViewLabelManifestV1: {
      sequence: [
        { name: "wire_tag", type: "uint16", const: 0x0e01 },
        { name: "labels", type: "array", kind: "length_prefixed", length_type: "uint32", items: { type: "ViewLabelManifestEntryV1" } },
      ],
    },
    ViewLabelManifestEntryV1: {
      sequence: [
        { name: "name", type: "string", kind: "length_prefixed", length_type: "uint32", encoding: "utf8" },
        { name: "view", type: "ViewId" },
        // Zero or one full source ref (for example `refs/heads/main`). Native
        // labels remain short (`main`); this field only records import provenance.
        { name: "original_git_refs", type: "array", kind: "length_prefixed", length_type: "uint32", items: { type: "string", kind: "length_prefixed", length_type: "uint32", encoding: "utf8" } },
        // Present on a label that is published as an annotated Git tag. Stored
        // so the tag object is the same wherever and whenever it is pushed.
        { name: "annotation", type: "optional", value_type: "LabelAnnotationV1" },
      ],
    },
    LabelAnnotationV1: {
      sequence: [
        { name: "tagger", type: "ActorV1" },
        { name: "tagged_at", type: "TimestampV1" },
        { name: "message", type: "string", kind: "length_prefixed", length_type: "uint32", encoding: "utf8" },
      ],
    },
    RepositoryEnvelopeV1: {
      sequence: [
        { name: "wire_tag", type: "uint16", const: 0x0f01 },
        { name: "state", type: "RepositoryStateId" },
        { name: "labels", type: "ViewLabelManifestId" },
      ],
    },

    // Experimental standalone edit definition. V1 intentionally contains only
    // canonical matching inputs; coordinates and lineage live elsewhere.
    EditV1: {
      sequence: [
        { name: "wire_tag", type: "uint16", const: 0x1001 },
        { name: "path", type: "string", kind: "length_prefixed", length_type: "uint32", encoding: "utf8" },
        { name: "operation", type: "EditOperationV1" },
      ],
    },
    EditOperationV1: {
      type: "discriminated_union",
      discriminator: { peek: "uint8" },
      variants: [
        { type: "GuardedTextEditV1", when: "value == 0" },
        { type: "ExactFileEditV1", when: "value == 1" },
      ],
    },
    GuardedTextEditV1: {
      sequence: [
        { name: "operation_kind", type: "uint8", const: 0 },
        { name: "kind", type: "FileKindV1" },
        { name: "before", type: "ContentId" },
        { name: "expected", type: "ContentId" },
        { name: "replacement", type: "ContentId" },
        { name: "after", type: "ContentId" },
        { name: "start_anchor", type: "bool" },
        { name: "end_anchor", type: "bool" },
      ],
    },
    ExactFileEditV1: {
      sequence: [
        { name: "operation_kind", type: "uint8", const: 1 },
        // Zero or one element. Arrays avoid the generator's unsupported optional
        // fields directly inside discriminated-union variants.
        { name: "expected", type: "array", kind: "length_prefixed", length_type: "uint32", items: { type: "FileValueV1" } },
        { name: "replacement", type: "array", kind: "length_prefixed", length_type: "uint32", items: { type: "FileValueV1" } },
      ],
    },

    // Physical sealed-segment records. These deliberately are not variants of
    // WheatObject: changing segment layout must never change logical identity.
    SegmentPrefixV1: {
      sequence: [
        { name: "magic", type: "uint32", const: 0x57484541 },
        { name: "version", type: "uint16", const: 1 },
      ],
    },
    SegmentIndexEntryV1: {
      sequence: [
        { name: "namespace", type: "uint8" },
        { name: "kind", type: "uint16" },
        { name: "digest", type: "Digest256" },
        { name: "offset", type: "uint64" },
        // Codec identity is part of every physical record. 0 = raw, 1 = one
        // independent zstd frame, 2 = git delta patch, 3 = zstd'd git delta
        // patch, 4 = shared zstd block. Identity remains over the logical bytes.
        { name: "codec", type: "uint8" },
        { name: "stored_length", type: "uint64" },
        { name: "logical_length", type: "uint64" },
        // Delta records (codecs 2 and 3, metadata only) name a base record in
        // the same segment; depth is the base's depth plus one. Whole records
        // have no base and depth zero.
        { name: "delta_base", type: "optional", value_type: "Digest256" },
        { name: "delta_depth", type: "uint8" },
      ],
    },
    SegmentIndexPageV1: {
      sequence: [
        { name: "entries", type: "array", kind: "length_prefixed", length_type: "uint32", items: { type: "SegmentIndexEntryV1" } },
      ],
    },
    SegmentIndexKeyV1: {
      sequence: [
        { name: "namespace", type: "uint8" },
        { name: "digest", type: "Digest256" },
      ],
    },
    SegmentDirectoryEntryV1: {
      sequence: [
        { name: "first_key", type: "SegmentIndexKeyV1" },
        { name: "offset", type: "uint64" },
        { name: "length", type: "uint64" },
        { name: "page_digest", type: "Digest256" },
      ],
    },
    SegmentDirectoryV1: {
      sequence: [
        { name: "pages", type: "array", kind: "length_prefixed", length_type: "uint32", items: { type: "SegmentDirectoryEntryV1" } },
      ],
    },
    SegmentFooterV1: {
      sequence: [
        { name: "magic", type: "uint32", const: 0x57484654 },
        { name: "version", type: "uint16", const: 1 },
        { name: "total_length", type: "uint64" },
        { name: "object_count", type: "uint64" },
        { name: "index_start", type: "uint64" },
        { name: "directory_offset", type: "uint64" },
        { name: "directory_length", type: "uint64" },
        { name: "body_digest", type: "Digest256" },
      ],
    },
    // The local packed store's active segment is an append-only log: this
    // header, then one frame per durable append. Sealing rebuilds its records
    // into a V1 segment, so the log never needs a V1 tail.
    ActiveLogHeaderV1: {
      sequence: [
        { name: "magic", type: "uint32", const: 0x5748414c },
        { name: "version", type: "uint16", const: 1 },
        { name: "base_generation", type: "uint64" },
      ],
    },
    // One append: `payload_length` payload bytes follow the frame header, then a
    // SegmentIndexPageV1 of `index_length` bytes indexing them, then the trailer.
    ActiveLogFrameFieldsV1: {
      sequence: [
        { name: "magic", type: "uint32", const: 0x57484146 },
        { name: "generation", type: "uint64" },
        { name: "payload_length", type: "uint64" },
        { name: "index_length", type: "uint64" },
      ],
    },
    // `fields_digest` is BLAKE3 over the previous chain digest and the encoded
    // fields. It tells a header a crash tore from a frame that was damaged later.
    ActiveLogFrameHeaderV1: {
      sequence: [
        { name: "fields", type: "ActiveLogFrameFieldsV1" },
        { name: "fields_digest", type: "Digest256" },
      ],
    },
    // `chain_digest` is BLAKE3 over the previous chain digest and every byte of
    // the frame before this trailer. The log header's chain digest is BLAKE3 of
    // the encoded header.
    ActiveLogFrameTrailerV1: {
      sequence: [
        { name: "magic", type: "uint32", const: 0x57484154 },
        { name: "chain_digest", type: "Digest256" },
      ],
    },
    // Remote (object-store) packed catalog: one record per appended segment,
    // chained through `previous`.
    SegmentCatalogRecordV1: {
      sequence: [
        { name: "magic", type: "uint32", const: 0x57484352 },
        { name: "version", type: "uint16", const: 1 },
        { name: "generation", type: "uint64" },
        { name: "previous", type: "optional", value_type: "Digest256" },
        { name: "segment", type: "Digest256" },
        { name: "stored_length", type: "uint64" },
      ],
    },
    // Complete physical authority for the local packed-store catalog.
    PhysicalCatalogSnapshotV1: {
      sequence: [
        { name: "magic", type: "uint32", const: 0x57484354 },
        { name: "version", type: "uint16", const: 1 },
        { name: "generation", type: "uint64" },
        { name: "segments", type: "array", kind: "length_prefixed", length_type: "uint32", items: { type: "PhysicalSegmentDescriptorV1" } },
        { name: "content", type: "PhysicalContentGenerationV1" },
      ],
    },
    PhysicalSegmentDescriptorV1: {
      sequence: [
        { name: "generation", type: "uint64" },
        { name: "sequence", type: "uint64" },
        { name: "segment", type: "Digest256" },
        { name: "stored_length", type: "uint64" },
      ],
    },
    PhysicalContentGenerationV1: {
      sequence: [
        { name: "generation", type: "uint64" },
        { name: "manifest", type: "Digest256" },
      ],
    },
    // One catalog snapshot by name: its generation and the BLAKE3 digest of its
    // encoded PhysicalCatalogSnapshotV1.
    PhysicalCatalogRefV1: {
      sequence: [
        { name: "generation", type: "uint64" },
        { name: "digest", type: "Digest256" },
      ],
    },
    // `catalog.head`: the snapshot that is the local packed store's authority.
    // No snapshot means a store that has not sealed anything yet.
    PhysicalCatalogHeadV1: {
      sequence: [
        { name: "magic", type: "uint32", const: 0x57484348 },
        { name: "version", type: "uint16", const: 1 },
        { name: "head", type: "optional", value_type: "PhysicalCatalogRefV1" },
      ],
    },
    // `repack.intent`: a repack about to move the head from `old` to `new`.
    RepackIntentFieldsV1: {
      sequence: [
        { name: "magic", type: "uint32", const: 0x57485249 },
        { name: "version", type: "uint16", const: 1 },
        { name: "old", type: "optional", value_type: "PhysicalCatalogRefV1" },
        { name: "new", type: "PhysicalCatalogRefV1" },
      ],
    },
    // `fields_digest` is BLAKE3 over the encoded fields.
    RepackIntentV1: {
      sequence: [
        { name: "fields", type: "RepackIntentFieldsV1" },
        { name: "fields_digest", type: "Digest256" },
      ],
    },

    // Physical content-repack manifests. These are outside WheatObject: they
    // describe replaceable storage representation, not logical object identity.
    // A generation is a top-level index of ID-range shards. Each shard has its
    // own manifest and pack; entries are split in ID order into shards of
    // exactly CONTENT_GENERATION_SHARD_ENTRIES (the last may hold fewer).
    ContentGenerationEntryV1: {
      sequence: [
        { name: "id", type: "ContentId" },
        { name: "envelope_digest", type: "Digest256" },
        // Offset in this entry's shard pack. A delta base may live in any shard.
        { name: "pack_offset", type: "uint64" },
        { name: "physical_length", type: "uint64" },
        { name: "logical_length", type: "uint64" },
        { name: "delta_base", type: "optional", value_type: "ContentId" },
        { name: "delta_depth", type: "uint8" },
      ],
    },
    // One shard as the top-level index names it. `manifest` is the BLAKE3
    // digest of the shard's encoded ContentGenerationShardV1.
    ContentGenerationShardRefV1: {
      sequence: [
        { name: "first_id", type: "ContentId" },
        { name: "entry_count", type: "uint32" },
        { name: "pack_length", type: "uint64" },
        { name: "manifest", type: "Digest256" },
      ],
    },
    // Top-level generation index; the catalog names its BLAKE3 digest.
    ContentGenerationManifestV1: {
      sequence: [
        { name: "magic", type: "uint32", const: 0x5748434d },
        { name: "version", type: "uint16", const: 1 },
        { name: "generation", type: "uint64" },
        { name: "entry_count", type: "uint64" },
        { name: "shards", type: "array", kind: "length_prefixed", length_type: "uint32", items: { type: "ContentGenerationShardRefV1" } },
        { name: "content_fingerprint", type: "Digest256" },
        { name: "manifest_digest", type: "Digest256" },
      ],
    },
    // What an index's `manifest_digest` covers: hashed after the domain tag
    // "wheat-content-generation-index-v1\0", never stored. The fingerprint is
    // the tag "wheat-content-generation-v1\0" followed by every entry's
    // ContentGenerationEntryV1 encoding in ID order.
    ContentGenerationIndexDigestInputV1: {
      sequence: [
        { name: "generation", type: "uint64" },
        { name: "content_fingerprint", type: "Digest256" },
        { name: "entry_count", type: "uint64" },
        { name: "shards", type: "array", kind: "length_prefixed", length_type: "uint32", items: { type: "ContentGenerationShardRefV1" } },
      ],
    },
    ContentGenerationShardV1: {
      sequence: [
        { name: "magic", type: "uint32", const: 0x57484353 },
        { name: "version", type: "uint16", const: 1 },
        { name: "generation", type: "uint64" },
        { name: "shard", type: "uint32" },
        { name: "entries", type: "array", kind: "length_prefixed", length_type: "uint32", items: { type: "ContentGenerationEntryV1" } },
      ],
    },

    // Store control records. Like the physical records above, none of these are
    // WheatObject variants.

    // `repository.head`: the published generation and its repository envelope.
    RepositoryHeadV1: {
      sequence: [
        { name: "magic", type: "uint32", const: 0x57485248 },
        { name: "version", type: "uint16", const: 1 },
        { name: "generation", type: "uint64" },
        { name: "envelope", type: "Digest256" },
      ],
    },
    // The fixed header in front of every stored content envelope's payload.
    // `codec` is the physical codec (0 raw, 1 zstd, 2 delta, 3 zstd'd delta);
    // `stored_length` payload bytes follow.
    ContentEnvelopeHeaderV1: {
      sequence: [
        { name: "magic", type: "uint32", const: 0x57484345 },
        { name: "version", type: "uint8", const: 1 },
        { name: "codec", type: "uint8" },
        { name: "stored_length", type: "uint64" },
        { name: "logical_length", type: "uint64" },
      ],
    },
    // One object or content blob a manifest accounts for, sorted by `id`.
    InventoryEntryV1: {
      sequence: [
        { name: "id", type: "Digest256" },
        { name: "bytes", type: "uint64" },
      ],
    },
    // A native repository snapshot's manifest; its BLAKE3 digest is the snapshot ID.
    SnapshotManifestV1: {
      sequence: [
        { name: "magic", type: "uint32", const: 0x5748534e },
        { name: "version", type: "uint16", const: 1 },
        { name: "head_generation", type: "uint64" },
        { name: "head_envelope", type: "Digest256" },
        { name: "envelope", type: "Digest256" },
        { name: "objects", type: "array", kind: "length_prefixed", length_type: "uint32", items: { type: "InventoryEntryV1" } },
        { name: "contents", type: "array", kind: "length_prefixed", length_type: "uint32", items: { type: "InventoryEntryV1" } },
      ],
    },
    // What one owner (1 = repository, 2 = snapshot) keeps alive; its BLAKE3
    // digest is the manifest ID.
    OwnershipManifestV1: {
      sequence: [
        { name: "magic", type: "uint32", const: 0x57484f4d },
        { name: "version", type: "uint16", const: 1 },
        { name: "owner_kind", type: "uint8" },
        { name: "owner_id", type: "Digest256" },
        { name: "objects", type: "array", kind: "length_prefixed", length_type: "uint32", items: { type: "InventoryEntryV1" } },
        { name: "contents", type: "array", kind: "length_prefixed", length_type: "uint32", items: { type: "InventoryEntryV1" } },
      ],
    },
    // One record of a workspace materialization's `progress.log`. `opcode` is
    // 1 = install intent (`index` installs announced), 2 = complete, 3 = aborted
    // (`index` is the install count either way).
    MaterializationProgressFieldsV1: {
      sequence: [
        { name: "magic", type: "uint32", const: 0x57484d50 },
        { name: "version", type: "uint16", const: 1 },
        { name: "opcode", type: "uint16" },
        { name: "transaction", type: "Uuid128" },
        { name: "index", type: "uint64" },
      ],
    },
    // `checksum` is CRC-32 over the encoded fields: it tells a torn append.
    MaterializationProgressRecordV1: {
      sequence: [
        { name: "fields", type: "MaterializationProgressFieldsV1" },
        { name: "checksum", type: "uint32" },
      ],
    },
    // The Git source a staged import is bound to. The import journal keeps these
    // bytes and refuses to resume against a source whose bytes differ.
    GitImportSourceV1: {
      sequence: [
        { name: "magic", type: "uint32", const: 0x57484749 },
        { name: "version", type: "uint16", const: 1 },
        { name: "path", type: "bytes", kind: "length_prefixed", length_type: "uint32" },
        { name: "head", type: "bytes", kind: "length_prefixed", length_type: "uint32" },
        { name: "refs", type: "array", kind: "length_prefixed", length_type: "uint32", items: { type: "GitImportRefV1" } },
      ],
    },
    GitImportRefV1: {
      sequence: [
        { name: "name", type: "bytes", kind: "length_prefixed", length_type: "uint32" },
        { name: "oid", type: "bytes", kind: "length_prefixed", length_type: "uint32" },
      ],
    },
  },
}
