{
  // Wheat native wire protocol — message-level schema.
  //
  // This is separate from the immutable-object schema (wheat-objects.bs.json5).
  // Objects use strict canonical encoding (reject trailing bytes); protocol
  // messages are framed by WebSocket and use a single message_type byte
  // for dispatch.
  //
  // Each WebSocket binary message contains:
  //   [message_type: u8] [binschema-encoded payload]
  //
  // The message_type byte selects the WheatProtocolMessage variant.
  // Type bytes 0x00–0x7f are core protocol; 0x80–0xff are reserved for
  // extensions (unknown types in this range are ignored by older peers).
  meta: {
    title: "Wheat Native Wire Protocol",
    description: "WebSocket message types for wheat-to-wheat synchronization: session setup, fetch, publish, content transfer, flow control.",
    version: "0.1.0",
  },
  config: {
    endianness: "big_endian",
    bit_order: "msb_first",
  },
  types: {
    // Top-level message dispatch.
    WheatProtocolMessage: {
      type: "discriminated_union",
      discriminator: { peek: "uint8" },
      variants: [
        // Session (0x01–0x03)
        { type: "ServerHello",           when: "value == 0x01" },
        { type: "ClientHello",           when: "value == 0x02" },
        { type: "SessionEstablished",    when: "value == 0x03" },

        // Repository (0x11). The WebSocket path names the repository, and the
        // server sends its RepositoryState once the session is established.
        { type: "RepositoryState",       when: "value == 0x11" },

        // Fetch (0x20–0x26)
        { type: "FetchRequest",          when: "value == 0x20" },
        { type: "ObjectBatch",           when: "value == 0x21" },
        { type: "ObjectWant",            when: "value == 0x22" },
        { type: "FetchComplete",         when: "value == 0x23" },
        { type: "FetchPushEnd",          when: "value == 0x24" },
        { type: "ObjectWantReply",       when: "value == 0x25" },
        { type: "ObjectChunk",           when: "value == 0x26" },

        // Content (0x30–0x34)
        { type: "ContentFetchRequest",   when: "value == 0x30" },
        { type: "ContentBatch",          when: "value == 0x31" },
        { type: "ContentChunk",          when: "value == 0x32" },
        { type: "ContentRedirect",       when: "value == 0x33" },

        // Publish (0x40–0x4b)
        { type: "PublishRequest",        when: "value == 0x40" },
        { type: "ObjectsNeeded",         when: "value == 0x41" },
        { type: "ObjectsComplete",       when: "value == 0x42" },
        { type: "ContentNeeded",         when: "value == 0x43" },
        // 0x44, 0x45: unused (upload-only content messages, replaced by
        // ContentBatch and ContentChunk).
        { type: "ContentUploadComplete", when: "value == 0x46" },
        { type: "PublishCommit",         when: "value == 0x47" },
        { type: "PublishProgress",       when: "value == 0x48" },
        { type: "PublishResult",         when: "value == 0x49" },
        { type: "ContentComplete",       when: "value == 0x4a" },
        { type: "PublishPushEnd",        when: "value == 0x4b" },

        // Admin (0x50–0x53). Only a session on the admin path speaks these.
        { type: "AdminStart",            when: "value == 0x50" },
        { type: "AdminStarted",          when: "value == 0x51" },
        { type: "AdminStatusRequest",    when: "value == 0x52" },
        { type: "AdminStatus",           when: "value == 0x53" },

        // Flow control (0x60)
        { type: "Credit",               when: "value == 0x60" },

        // Errors (0x70)
        { type: "Error",                 when: "value == 0x70" },
      ],
    },

    // ─────────────────────────────────────────────────────────────────────
    // Shared sub-types
    // ─────────────────────────────────────────────────────────────────────

    // 32-byte BLAKE3-256 digest, used for ObjectId, ViewId, ContentId, etc.
    // Protocol messages use raw digests — the semantic meaning (object vs
    // content vs envelope) is clear from context.
    Digest256: {
      sequence: [
        { name: "bytes", type: "bytes", kind: "fixed", length: 32 },
      ],
    },

    // UUID-128 for ChangeId, publish_key, receipt_id.
    Uuid128: {
      sequence: [
        { name: "bytes", type: "bytes", kind: "fixed", length: 16 },
      ],
    },

    // A single structural object with its identity.
    ObjectEntry: {
      sequence: [
        { name: "id", type: "Digest256" },
        { name: "data", type: "bytes", kind: "length_prefixed", length_type: "varlength", length_encoding: "leb128_canonical" },
      ],
    },

    // A single content blob with its identity.
    ContentEntry: {
      sequence: [
        { name: "id", type: "Digest256" },
        { name: "data", type: "bytes", kind: "length_prefixed", length_type: "varlength", length_encoding: "leb128_canonical" },
      ],
    },

    // ─────────────────────────────────────────────────────────────────────
    // Session messages
    // ─────────────────────────────────────────────────────────────────────

    // `capabilities` offers the optional modes the server supports; the client
    // names in ClientHello the ones the session uses.
    ServerHello: {
      sequence: [
        { name: "message_type", type: "uint8", const: 0x01 },
        { name: "protocol_version_min", type: "uint16" },
        { name: "protocol_version_max", type: "uint16" },
        { name: "server_id", type: "bytes", kind: "fixed", length: 32 },
        {
          name: "capabilities",
          type: "array",
          kind: "length_prefixed",
          length_type: "varlength", length_encoding: "leb128_canonical",
          items: { type: "string", kind: "length_prefixed", length_type: "varlength", length_encoding: "leb128_canonical", encoding: "utf8" },
        },
      ],
    },

    ClientHello: {
      sequence: [
        { name: "message_type", type: "uint8", const: 0x02 },
        { name: "selected_version", type: "uint16" },
        // The client authenticates on the WebSocket upgrade request (an
        // `Authorization: Bearer` header), not here.
        { name: "receive_window_bytes", type: "uint32" },
        { name: "receive_window_messages", type: "uint16" },
        // The capabilities from ServerHello this session uses; the server refuses
        // one it did not offer.
        {
          name: "capabilities",
          type: "array",
          kind: "length_prefixed",
          length_type: "varlength", length_encoding: "leb128_canonical",
          items: { type: "string", kind: "length_prefixed", length_type: "varlength", length_encoding: "leb128_canonical", encoding: "utf8" },
        },
      ],
    },

    SessionEstablishedStatus: {
      type: "discriminated_union",
      discriminator: { peek: "uint8" },
      variants: [
        { type: "SessionStatusOk",              when: "value == 0" },
        { type: "SessionStatusVersionMismatch", when: "value == 1" },
        { type: "SessionStatusAuthFailed",      when: "value == 2" },
      ],
    },
    SessionStatusOk:              { sequence: [{ name: "code", type: "uint8", const: 0 }] },
    SessionStatusVersionMismatch: { sequence: [{ name: "code", type: "uint8", const: 1 }] },
    SessionStatusAuthFailed:      { sequence: [{ name: "code", type: "uint8", const: 2 }] },

    SessionEstablished: {
      sequence: [
        { name: "message_type", type: "uint8", const: 0x03 },
        { name: "selected_version", type: "uint16" },
        { name: "receive_window_bytes", type: "uint32" },
        { name: "receive_window_messages", type: "uint16" },
        { name: "status", type: "SessionEstablishedStatus" },
        // Supported range included on version_mismatch so client can retry.
        { name: "supported_range_min", type: "uint16" },
        { name: "supported_range_max", type: "uint16" },
        { name: "message", type: "string", kind: "length_prefixed", length_type: "varlength", length_encoding: "leb128_canonical", encoding: "utf8" },
      ],
    },

    // ─────────────────────────────────────────────────────────────────────
    // Repository messages
    // ─────────────────────────────────────────────────────────────────────

    RepositoryState: {
      sequence: [
        { name: "message_type", type: "uint8", const: 0x11 },
        { name: "head_generation", type: "varlength", encoding: "leb128_canonical" },
        { name: "head_envelope", type: "Digest256" },
      ],
    },

    // ─────────────────────────────────────────────────────────────────────
    // Fetch messages
    // ─────────────────────────────────────────────────────────────────────

    // A fetch has two phases. Push: the server sends the structural objects of
    // want_envelope that since_envelope (the client's last fetched head, zeros for
    // none) does not already cover, as ObjectBatch and ObjectChunk messages, then
    // FetchPushEnd. Pull: the client checks what it has, sends one ObjectWant at a
    // time for anything still missing, and gets exactly one ObjectWantReply for
    // each. FetchComplete ends the fetch.
    FetchRequest: {
      sequence: [
        { name: "message_type", type: "uint8", const: 0x20 },
        { name: "op_id", type: "varlength", encoding: "leb128_canonical" },
        { name: "want_envelope", type: "Digest256" },
        { name: "since_envelope", type: "Digest256" },
      ],
    },

    // Whole objects, at most MAX_OBJECT_BATCH_ITEMS and MAX_OBJECT_BATCH_SIZE bytes
    // of object data. An object larger than MAX_OBJECT_BATCH_SIZE goes as
    // ObjectChunks instead.
    ObjectBatch: {
      sequence: [
        { name: "message_type", type: "uint8", const: 0x21 },
        { name: "op_id", type: "varlength", encoding: "leb128_canonical" },
        { name: "sequence", type: "varlength", encoding: "leb128_canonical" },
        {
          name: "objects",
          type: "array",
          kind: "length_prefixed",
          length_type: "varlength", length_encoding: "leb128_canonical",
          items: { type: "ObjectEntry" },
        },
      ],
    },

    // At most MAX_WANT_IDS objects the client still lacks. want_sequence counts the
    // fetch's wants from 0. An ID the server does not have ends the fetch with an
    // Error naming it.
    ObjectWant: {
      sequence: [
        { name: "message_type", type: "uint8", const: 0x22 },
        { name: "op_id", type: "varlength", encoding: "leb128_canonical" },
        { name: "want_sequence", type: "varlength", encoding: "leb128_canonical" },
        {
          name: "ids",
          type: "array",
          kind: "length_prefixed",
          length_type: "varlength", length_encoding: "leb128_canonical",
          items: { type: "Digest256" },
        },
      ],
    },

    FetchComplete: {
      sequence: [
        { name: "message_type", type: "uint8", const: 0x23 },
        { name: "op_id", type: "varlength", encoding: "leb128_canonical" },
      ],
    },

    // The push phase is over. incremental says whether the server left out what
    // since_envelope covers (false when it did not know since_envelope).
    FetchPushEnd: {
      sequence: [
        { name: "message_type", type: "uint8", const: 0x24 },
        { name: "op_id", type: "varlength", encoding: "leb128_canonical" },
        { name: "pushed_objects", type: "varlength", encoding: "leb128_canonical" },
        { name: "incremental", type: "bool" },
      ],
    },

    // The answer to one ObjectWant: the wanted objects from the front of its list
    // that fit in one batch, in the want's order. When the first one is too large
    // for a batch it comes before this reply as ObjectChunks, and the reply holds
    // the ones after it that fit. Every reply answers at least one ID; the client
    // asks again for the rest.
    ObjectWantReply: {
      sequence: [
        { name: "message_type", type: "uint8", const: 0x25 },
        { name: "op_id", type: "varlength", encoding: "leb128_canonical" },
        { name: "want_sequence", type: "varlength", encoding: "leb128_canonical" },
        {
          name: "objects",
          type: "array",
          kind: "length_prefixed",
          length_type: "varlength", length_encoding: "leb128_canonical",
          items: { type: "ObjectEntry" },
        },
      ],
    },

    // One piece of an object larger than MAX_OBJECT_BATCH_SIZE, at most
    // MAX_OBJECT_CHUNK_SIZE bytes. Pieces of one object come in order and are not
    // mixed with pieces of another.
    ObjectChunk: {
      sequence: [
        { name: "message_type", type: "uint8", const: 0x26 },
        { name: "op_id", type: "varlength", encoding: "leb128_canonical" },
        { name: "object_id", type: "Digest256" },
        { name: "offset", type: "varlength", encoding: "leb128_canonical" },
        { name: "data", type: "bytes", kind: "length_prefixed", length_type: "varlength", length_encoding: "leb128_canonical" },
        { name: "is_final", type: "bool" },
      ],
    },

    // ─────────────────────────────────────────────────────────────────────
    // Content messages
    // ─────────────────────────────────────────────────────────────────────

    ContentFetchRequest: {
      sequence: [
        { name: "message_type", type: "uint8", const: 0x30 },
        { name: "op_id", type: "varlength", encoding: "leb128_canonical" },
        {
          name: "content_ids",
          type: "array",
          kind: "length_prefixed",
          length_type: "varlength", length_encoding: "leb128_canonical",
          items: { type: "Digest256" },
        },
      ],
    },

    ContentBatch: {
      sequence: [
        { name: "message_type", type: "uint8", const: 0x31 },
        { name: "op_id", type: "varlength", encoding: "leb128_canonical" },
        { name: "sequence", type: "varlength", encoding: "leb128_canonical" },
        {
          name: "contents",
          type: "array",
          kind: "length_prefixed",
          length_type: "varlength", length_encoding: "leb128_canonical",
          items: { type: "ContentEntry" },
        },
      ],
    },

    ContentChunk: {
      sequence: [
        { name: "message_type", type: "uint8", const: 0x32 },
        { name: "op_id", type: "varlength", encoding: "leb128_canonical" },
        { name: "content_id", type: "Digest256" },
        { name: "offset", type: "varlength", encoding: "leb128_canonical" },
        { name: "data", type: "bytes", kind: "length_prefixed", length_type: "varlength", length_encoding: "leb128_canonical" },
        { name: "is_final", type: "bool" },
      ],
    },

    ContentRedirect: {
      sequence: [
        { name: "message_type", type: "uint8", const: 0x33 },
        { name: "op_id", type: "varlength", encoding: "leb128_canonical" },
        { name: "content_id", type: "Digest256" },
        { name: "url", type: "string", kind: "length_prefixed", length_type: "varlength", length_encoding: "leb128_canonical", encoding: "utf8" },
        { name: "expires_seconds", type: "varlength", encoding: "leb128_canonical" },
      ],
    },

    // ─────────────────────────────────────────────────────────────────────
    // Publish messages
    // ─────────────────────────────────────────────────────────────────────

    PublishRequest: {
      sequence: [
        { name: "message_type", type: "uint8", const: 0x40 },
        { name: "op_id", type: "varlength", encoding: "leb128_canonical" },
        { name: "publish_key", type: "Uuid128" },
        { name: "envelope_id", type: "Digest256" },
        { name: "expected_generation", type: "varlength", encoding: "leb128_canonical" },
        { name: "expected_envelope", type: "Digest256" },
        { name: "force", type: "bool" },
        // Moves labels to views that are not forward from where they were.
        { name: "force_labels", type: "bool" },
      ],
    },

    // One round of a publish's object phase: at most MAX_WANT_IDS objects of the
    // proposed envelope that the server lacks. The client answers with exactly
    // those objects, each once, in ObjectBatch and ObjectChunk messages, and
    // nothing else. The server asks for the next round only once all of them have
    // arrived.
    ObjectsNeeded: {
      sequence: [
        { name: "message_type", type: "uint8", const: 0x41 },
        { name: "op_id", type: "varlength", encoding: "leb128_canonical" },
        {
          name: "ids",
          type: "array",
          kind: "length_prefixed",
          length_type: "varlength", length_encoding: "leb128_canonical",
          items: { type: "Digest256" },
        },
      ],
    },

    // The server has every object of the proposed envelope; the content phase
    // follows.
    ObjectsComplete: {
      sequence: [
        { name: "message_type", type: "uint8", const: 0x42 },
        { name: "op_id", type: "varlength", encoding: "leb128_canonical" },
      ],
    },

    // The server asks for missing content in rounds of at most MAX_WANT_IDS. The
    // client answers each round with the uploads and one ContentUploadComplete;
    // ContentComplete then says nothing more is needed.
    ContentNeeded: {
      sequence: [
        { name: "message_type", type: "uint8", const: 0x43 },
        { name: "op_id", type: "varlength", encoding: "leb128_canonical" },
        {
          name: "content_ids",
          type: "array",
          kind: "length_prefixed",
          length_type: "varlength", length_encoding: "leb128_canonical",
          items: { type: "Digest256" },
        },
      ],
    },

    // A publish uploads content in ContentBatch and ContentChunk, like a fetch
    // downloads it. 0x44 and 0x45 were the upload-only messages; they stay unused.

    ContentUploadComplete: {
      sequence: [
        { name: "message_type", type: "uint8", const: 0x46 },
        { name: "op_id", type: "varlength", encoding: "leb128_canonical" },
      ],
    },

    ContentComplete: {
      sequence: [
        { name: "message_type", type: "uint8", const: 0x4a },
        { name: "op_id", type: "varlength", encoding: "leb128_canonical" },
      ],
    },

    // Ends what the client pushed unasked straight after its PublishRequest: the
    // objects of its walk from the expected head (ObjectBatch) and the added blobs
    // of at most MAX_PUSHED_BLOB_SIZE bytes (ContentUpload), together at most
    // MAX_PUSHED_BYTES. The counts are of what was sent, so nothing is lost
    // unnoticed. The server takes what its own walk needs and asks for the rest.
    PublishPushEnd: {
      sequence: [
        { name: "message_type", type: "uint8", const: 0x4b },
        { name: "op_id", type: "varlength", encoding: "leb128_canonical" },
        { name: "pushed_objects", type: "varlength", encoding: "leb128_canonical" },
        { name: "pushed_contents", type: "varlength", encoding: "leb128_canonical" },
      ],
    },

    PublishCommit: {
      sequence: [
        { name: "message_type", type: "uint8", const: 0x47 },
        { name: "op_id", type: "varlength", encoding: "leb128_canonical" },
      ],
    },

    PublishProgress: {
      sequence: [
        { name: "message_type", type: "uint8", const: 0x48 },
        { name: "op_id", type: "varlength", encoding: "leb128_canonical" },
        { name: "phase", type: "string", kind: "length_prefixed", length_type: "varlength", length_encoding: "leb128_canonical", encoding: "utf8" },
        // 0-100 = percent, 255 = indeterminate.
        { name: "percent", type: "uint8" },
      ],
    },

    PublishResultStatus: {
      type: "discriminated_union",
      discriminator: { peek: "uint8" },
      variants: [
        { type: "PublishStatusOk",               when: "value == 0" },
        { type: "PublishStatusStaleHead",        when: "value == 1" },
        { type: "PublishStatusRejected",         when: "value == 2" },
        { type: "PublishStatusAlreadyCommitted", when: "value == 3" },
        { type: "PublishStatusError",            when: "value == 4" },
      ],
    },
    PublishStatusOk:               { sequence: [{ name: "code", type: "uint8", const: 0 }] },
    PublishStatusStaleHead:        { sequence: [{ name: "code", type: "uint8", const: 1 }] },
    PublishStatusRejected:         { sequence: [{ name: "code", type: "uint8", const: 2 }] },
    PublishStatusAlreadyCommitted: { sequence: [{ name: "code", type: "uint8", const: 3 }] },
    PublishStatusError:            { sequence: [{ name: "code", type: "uint8", const: 4 }] },

    PublishResult: {
      sequence: [
        { name: "message_type", type: "uint8", const: 0x49 },
        { name: "op_id", type: "varlength", encoding: "leb128_canonical" },
        { name: "receipt_id", type: "Uuid128" },
        { name: "status", type: "PublishResultStatus" },
        { name: "new_generation", type: "varlength", encoding: "leb128_canonical" },
        { name: "new_envelope", type: "Digest256" },
        { name: "message", type: "string", kind: "length_prefixed", length_type: "varlength", length_encoding: "leb128_canonical", encoding: "utf8" },
      ],
    },

    // ─────────────────────────────────────────────────────────────────────
    // Admin messages
    // ─────────────────────────────────────────────────────────────────────
    //
    // A session whose WebSocket path is the admin path (`/.admin`) is not for a
    // repository: after SessionEstablished the server sends no RepositoryState, and
    // the client may send these instead, if its principal is an admin. An operation
    // outlives the request that started it: AdminStarted names it, and
    // AdminStatusRequest asks how it is going, on this session or a later one. The
    // server runs one operation at a time per repositories directory. Paths name
    // bundles and repositories under the server's exchange directory, one segment
    // each.

    // Copies a repository's whole fork network to a new bundle.
    AdminExportCommand: {
      sequence: [
        { name: "command_kind", type: "uint8", const: 1 },
        // The repository whose network is exported, as `owner/repo`.
        { name: "repository", type: "string", kind: "length_prefixed", length_type: "varlength", length_encoding: "leb128_canonical", encoding: "utf8" },
        // The bundle's name in the exchange directory; it must not exist.
        { name: "bundle", type: "string", kind: "length_prefixed", length_type: "varlength", length_encoding: "leb128_canonical", encoding: "utf8" },
      ],
    },

    // The name a repository of an imported network gets.
    AdminRepositoryName: {
      sequence: [
        { name: "repository", type: "Uuid128" },
        { name: "name", type: "string", kind: "length_prefixed", length_type: "varlength", length_encoding: "leb128_canonical", encoding: "utf8" },
      ],
    },

    // Places the network of a bundle in the exchange directory, giving each of its
    // repositories a name.
    AdminImportCommand: {
      sequence: [
        { name: "command_kind", type: "uint8", const: 2 },
        { name: "bundle", type: "string", kind: "length_prefixed", length_type: "varlength", length_encoding: "leb128_canonical", encoding: "utf8" },
        {
          name: "names",
          type: "array",
          kind: "length_prefixed",
          length_type: "varlength", length_encoding: "leb128_canonical",
          items: { type: "AdminRepositoryName" },
        },
      ],
    },

    // Places a standalone repository (what `wheat import` writes) from the exchange
    // directory in a network of its own.
    AdminAdoptCommand: {
      sequence: [
        { name: "command_kind", type: "uint8", const: 3 },
        { name: "source", type: "string", kind: "length_prefixed", length_type: "varlength", length_encoding: "leb128_canonical", encoding: "utf8" },
        { name: "name", type: "string", kind: "length_prefixed", length_type: "varlength", length_encoding: "leb128_canonical", encoding: "utf8" },
      ],
    },

    AdminCommand: {
      type: "discriminated_union",
      discriminator: { peek: "uint8" },
      variants: [
        { type: "AdminExportCommand", when: "value == 1" },
        { type: "AdminImportCommand", when: "value == 2" },
        { type: "AdminAdoptCommand",  when: "value == 3" },
      ],
    },

    AdminStart: {
      sequence: [
        { name: "message_type", type: "uint8", const: 0x50 },
        { name: "op_id", type: "varlength", encoding: "leb128_canonical" },
        { name: "command", type: "AdminCommand" },
      ],
    },

    // The operation AdminStart began.
    AdminStarted: {
      sequence: [
        { name: "message_type", type: "uint8", const: 0x51 },
        { name: "op_id", type: "varlength", encoding: "leb128_canonical" },
        { name: "operation", type: "varlength", encoding: "leb128_canonical" },
      ],
    },

    AdminStatusRequest: {
      sequence: [
        { name: "message_type", type: "uint8", const: 0x52 },
        { name: "op_id", type: "varlength", encoding: "leb128_canonical" },
        { name: "operation", type: "varlength", encoding: "leb128_canonical" },
      ],
    },

    AdminState: {
      type: "discriminated_union",
      discriminator: { peek: "uint8" },
      variants: [
        { type: "AdminRunning",   when: "value == 0" },
        { type: "AdminSucceeded", when: "value == 1" },
        { type: "AdminFailed",    when: "value == 2" },
      ],
    },
    AdminRunning:   { sequence: [{ name: "code", type: "uint8", const: 0 }] },
    AdminSucceeded: { sequence: [{ name: "code", type: "uint8", const: 1 }] },
    AdminFailed:    { sequence: [{ name: "code", type: "uint8", const: 2 }] },

    // How an operation is going. `phase` says what a running one is doing; `message`
    // is what a finished one produced, or why it failed.
    AdminStatus: {
      sequence: [
        { name: "message_type", type: "uint8", const: 0x53 },
        { name: "op_id", type: "varlength", encoding: "leb128_canonical" },
        { name: "operation", type: "varlength", encoding: "leb128_canonical" },
        { name: "state", type: "AdminState" },
        { name: "phase", type: "string", kind: "length_prefixed", length_type: "varlength", length_encoding: "leb128_canonical", encoding: "utf8" },
        { name: "message", type: "string", kind: "length_prefixed", length_type: "varlength", length_encoding: "leb128_canonical", encoding: "utf8" },
      ],
    },

    // ─────────────────────────────────────────────────────────────────────
    // Flow control
    // ─────────────────────────────────────────────────────────────────────

    Credit: {
      sequence: [
        { name: "message_type", type: "uint8", const: 0x60 },
        // op_id=0 is connection-level credit (before any operation opens).
        { name: "op_id", type: "varlength", encoding: "leb128_canonical" },
        // Acknowledges all batches up to this sequence for the op_id.
        { name: "ack_through_sequence", type: "varlength", encoding: "leb128_canonical" },
        // Additive window: additional bytes the receiver can accept.
        { name: "window_bytes", type: "uint32" },
        // Additive window: additional messages the receiver can accept.
        { name: "window_messages", type: "uint16" },
      ],
    },

    // ─────────────────────────────────────────────────────────────────────
    // Errors
    // ─────────────────────────────────────────────────────────────────────

    ErrorScope: {
      type: "discriminated_union",
      discriminator: { peek: "uint8" },
      variants: [
        { type: "ErrorScopeConnection", when: "value == 0" },
        { type: "ErrorScopeOperation",  when: "value == 1" },
      ],
    },
    ErrorScopeConnection: { sequence: [{ name: "code", type: "uint8", const: 0 }] },
    ErrorScopeOperation:  { sequence: [{ name: "code", type: "uint8", const: 1 }] },

    Error: {
      sequence: [
        { name: "message_type", type: "uint8", const: 0x70 },
        // op_id=0 means connection-scoped.
        { name: "op_id", type: "varlength", encoding: "leb128_canonical" },
        { name: "code", type: "uint16" },
        { name: "scope", type: "ErrorScope" },
        { name: "retryable", type: "bool" },
        // For a retryable error: the server's estimate of how many seconds until trying
        // again can work (0 = no estimate). A repository refusing publishes while it
        // is moved or backed up says how long the operation is expected to take.
        { name: "retry_after_seconds", type: "varlength", encoding: "leb128_canonical" },
        { name: "message", type: "string", kind: "length_prefixed", length_type: "varlength", length_encoding: "leb128_canonical", encoding: "utf8" },
        // Optional: which object caused the error (empty digest = not applicable).
        { name: "object_id", type: "Digest256" },
      ],
    },
  },
}
